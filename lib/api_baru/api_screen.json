{
  "app_name": "Absensiku",
  "base_url_local": "http://localhost:8000",
  "base_url_emulator": "http://10.0.2.2:8000",
  "base_url_production": "https://absensib1.mobileprojp.com",
  "endpoints": {
    "auth": [
      {
        "name": "Daftar Akun (Register)",
        "screen": "RegisterScreen",
        "method": "POST",
        "path": "/api/register",
        "url_local": "http://localhost:8000/api/register",
        "url_production": "https://absensib1.mobileprojp.com/api/register",
        "description": "Pendaftaran akun baru pengguna",
        "requires_auth": false,
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "name": "",
          "email": "",
          "password": "",
          "password_confirmation": ""
        }
      },
      {
        "name": "Masuk Akun (Login)",
        "screen": "LoginScreen",
        "method": "POST",
        "path": "/api/login",
        "url_local": "http://localhost:8000/api/login",
        "url_production": "https://absensib1.mobileprojp.com/api/login",
        "description": "Login pengguna untuk mendapatkan Bearer Token",
        "requires_auth": false,
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "email": "",
          "password": ""
        }
      },
      {
        "name": "Ambil Profil Pengguna",
        "screen": "ProfileScreen",
        "method": "GET",
        "path": "/api/profile",
        "url_local": "http://localhost:8000/api/profile",
        "url_production": "https://absensib1.mobileprojp.com/api/profile",
        "description": "Mengambil data profil pengguna yang sedang login",
        "requires_auth": true,
        "headers": {
          "Authorization": "Bearer <token>",
          "Accept": "application/json"
        },
        "body": null
      },
      {
        "name": "Perbarui Profil Pengguna",
        "screen": "ProfileScreen",
        "method": "PUT",
        "path": "/api/profile",
        "url_local": "http://localhost:8000/api/profile",
        "url_production": "https://absensib1.mobileprojp.com/api/profile",
        "description": "Memperbarui nama dan email pengguna ke server API",
        "requires_auth": true,
        "headers": {
          "Authorization": "Bearer <token>",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "name": "",
          "email": ""
        }
      }
    ],
    "presensi": [
      {
        "name": "Absen Masuk (Check-In)",
        "screen": "HomeScreen / MapsScreen",
        "method": "POST",
        "path": "/api/absen/check-in",
        "url_local": "http://localhost:8000/api/absen/check-in",
        "url_production": "https://absensib1.mobileprojp.com/api/absen/check-in",
        "description": "Kirim absensi masuk beserta titik koordinat dan alamat",
        "requires_auth": true,
        "headers": {
          "Authorization": "Bearer <token>",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "check_in_lat": -6.200000,
          "check_in_lng": 106.816666,
          "check_in_address": ""
        }
      },
      {
        "name": "Absen Keluar (Check-Out)",
        "screen": "HomeScreen / MapsScreen",
        "method": "POST",
        "path": "/api/absen/check-out",
        "url_local": "http://localhost:8000/api/absen/check-out",
        "url_production": "https://absensib1.mobileprojp.com/api/absen/check-out",
        "description": "Kirim absensi pulang/keluar beserta titik koordinat dan alamat",
        "requires_auth": true,
        "headers": {
          "Authorization": "Bearer <token>",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "check_out_lat": -6.200000,
          "check_out_lng": 106.816666,
          "check_out_address": ""
        }
      },
      {
        "name": "Riwayat Absensi",
        "screen": "DaftarHadirScreen",
        "method": "GET",
        "path": "/api/absen/history",
        "url_local": "http://localhost:8000/api/absen/history",
        "url_production": "https://absensib1.mobileprojp.com/api/absen/history",
        "description": "Mengambil seluruh riwayat data absensi pengguna",
        "requires_auth": true,
        "headers": {
          "Authorization": "Bearer <token>",
          "Accept": "application/json"
        },
        "body": null
      },
      {
        "name": "Hapus Data Absensi",
        "screen": "DaftarHadirScreen",
        "method": "DELETE",
        "path": "/api/absen/{id}",
        "url_local": "http://localhost:8000/api/absen/{id}",
        "url_production": "https://absensib1.mobileprojp.com/api/absen/{id}",
        "description": "Menghapus data absensi spesifik berdasarkan ID absensi",
        "requires_auth": true,
        "headers": {
          "Authorization": "Bearer <token>",
          "Accept": "application/json"
        },
        "body": null
      }
    ]
  }
}
