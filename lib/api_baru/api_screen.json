{
  "screen": "register_screen",
  "title": "Daftar Akun Absensiku",
  "api_endpoint": "http://localhost:8000/api/register",
  "method": "POST",
  "headers": {
    "Content-Type": "application/json",
    "Accept": "application/json"
  },
  "form_data": {
    "name": "",
    "email": "",
    "password": "",
    "password_confirmation": ""
  },
  "fields": [
    {
      "key": "name",
      "label": "Nama Lengkap",
      "type": "text",
      "placeholder": "Masukkan nama lengkap Anda",
      "required": true,
      "icon": "person_outline",
      "validation": {
        "rule": "Nama lengkap wajib diisi"
      }
    },
    {
      "key": "email",
      "label": "Email",
      "type": "email",
      "placeholder": "Masukkan email Anda",
      "required": true,
      "icon": "email_outlined",
      "validation": {
        "rule": "Email wajib diisi dan format email valid"
      }
    },
    {
      "key": "password",
      "label": "Password",
      "type": "password",
      "placeholder": "Minimal 8 karakter: huruf besar, kecil & angka",
      "required": true,
      "icon": "lock_outline",
      "validation": {
        "min_length": 8,
        "requires_uppercase": true,
        "requires_lowercase": true,
        "requires_number_or_symbol": true,
        "rule": "Password minimal 8 karakter, wajib kombinasi huruf besar, kecil, dan angka/simbol (contoh: Rahasia123)"
      }
    },
    {
      "key": "password_confirmation",
      "label": "Konfirmasi Password",
      "type": "password",
      "placeholder": "Ulangi password Anda",
      "required": true,
      "icon": "lock_reset_outlined",
      "validation": {
        "match_field": "password",
        "rule": "Konfirmasi password harus cocok dengan password"
      }
    }
  ],
  "sample_request_payload": {
    "name": "Ahmad Fauzi",
    "email": "ahmad.fauzi@example.com",
    "password": "Password123!",
    "password_confirmation": "Password123!"
  },
  "sample_response_success": {
    "message": "User registered successfully",
    "data": {
      "token": "1|laravel_sanctum_token_absensiku_sample1234567890",
      "user": {
        "id": 1,
        "name": "Ahmad Fauzi",
        "email": "ahmad.fauzi@example.com",
        "email_verified_at": null,
        "created_at": "2026-09-26T10:30:00.000000Z",
        "updated_at": "2026-09-26T10:30:00.000000Z"
      }
    }
  },
  "sample_response_error": {
    "message": "The given data was invalid.",
    "errors": {
      "email": [
        "Email sudah terdaftar di server."
      ],
      "password": [
        "Password minimal 8 karakter dan mengandung huruf besar, huruf kecil, dan angka."
      ]
    }
  }
}
