{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Absensiku (Production API)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=BASE_URL=https://absensib1.mobileprojp.com"
      ]
    },
    {
      "name": "Absensiku (Local Backend - localhost:8000)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=BASE_URL=http://localhost:8000"
      ]
    },
    {
      "name": "Absensiku (Android Emulator - 10.0.2.2:8000)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=BASE_URL=http://10.0.2.2:8000"
      ]
    },
    {
      "name": "Absensiku (Profile Mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart"
    },
    {
      "name": "Absensiku (Release Mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart"
    }
  ]
}
